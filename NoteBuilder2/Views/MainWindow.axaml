<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
		MinHeight="600" MinWidth="700"
		CanResize="True"
        x:Class="NoteBuilder2.Views.MainWindow"
        Title="MainWindow">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Menu Grid.Row="0" Grid.ColumnSpan="4">
			<MenuItem Header="File">
				<MenuItem Header="Exit (Alt+F4)"/>
			</MenuItem>
			<MenuItem Header="Edit">
				<MenuItem Header="Edit NoteBlocks"/>
				<MenuItem Header="Edit Rules"/>
			</MenuItem>
		</Menu>
		
		<Button Grid.Row="1" Grid.Column="0" Content="Load Note" HorizontalAlignment="Center" VerticalAlignment="Center"/>
		<ComboBox Grid.Row= "1" Grid.Column="1" PlaceholderText="Saved Notes" HorizontalAlignment="Center" VerticalAlignment="Center"/>
		
		<Button Grid.Row="2" Grid.Column="0" Content="Insert Greeting" HorizontalAlignment="Center" VerticalAlignment="Center"/>
		<ComboBox Grid.Row= "2" Grid.Column="1" PlaceholderText="Saved Greetings" HorizontalAlignment="Center" VerticalAlignment="Center"/>
		<StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="2">
			<Label Content="Random" HorizontalAlignment="Center" VerticalAlignment="Center"/>
			<CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"/>
		</StackPanel>
		
		<Button Grid.Row="3" Grid.Column="0" Content="Insert Rule" HorizontalAlignment="Center" VerticalAlignment="Center"/>
		<ComboBox Grid.Row= "3" Grid.Column="1" PlaceholderText="Saved Rules" HorizontalAlignment="Center" VerticalAlignment="Center"/>
		<ComboBox Grid.Row= "3" Grid.Column="2" PlaceholderText="Rule Citation Level" HorizontalAlignment="Center" VerticalAlignment="Center"/>
		<ComboBox Grid.Row= "3" Grid.Column="3" PlaceholderText="Rule Citation" HorizontalAlignment="Center" VerticalAlignment="Center"/>

		<Button Grid.Row="4" Grid.Column="0" Content="Insert Citation" HorizontalAlignment="Center" VerticalAlignment="Center"/>
		<ComboBox Grid.Row= "4" Grid.Column="1" PlaceholderText="Citation Level" HorizontalAlignment="Center" VerticalAlignment="Center"/>
		<ComboBox Grid.Row= "4" Grid.Column="2" PlaceholderText="Citation" HorizontalAlignment="Center" VerticalAlignment="Center"/>

		<Button Grid.Row="5" Grid.Column="0" Content="Insert Signoff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
		<ComboBox Grid.Row= "5" Grid.Column="1" PlaceholderText="Saved Signoffs" HorizontalAlignment="Center" VerticalAlignment="Center"/>
		<StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="2">
			<Label Content="Random" HorizontalAlignment="Center" VerticalAlignment="Center"/>
			<CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"/>
		</StackPanel>

		<WrapPanel Grid.Row="6" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top">
			<ToggleButton Content="B" FontWeight="Bold" ToolTip.Tip="Bold (Ctrl+B)" />
			<ToggleButton Content="I" FontStyle="Italic" ToolTip.Tip="Italic (Ctrl+I)" />
			<ToggleButton Content="U" ToolTip.Tip="Underline (Ctrl+U)" />
			<ToggleButton Content="S" ToolTip.Tip="Strikethrough" />
			<ComboBox PlaceholderText="Colour"/>
			<Separator/>
			<ToggleButton Content="Left" ToolTip.Tip="Left Align" />
			<ToggleButton Content="Center" ToolTip.Tip="Center Align" />
			<ToggleButton Content="Justify" ToolTip.Tip="Justify" />
			<ToggleButton Content="Right" ToolTip.Tip="Right Align" />
			<Separator/>
			
			<ToggleButton Content='Quote' ToolTip.Tip="Quote" />
			<ToggleButton Content='Link' ToolTip.Tip="Link" />
			<ToggleButton Content='Dropdown' ToolTip.Tip="Dropdown" />
			<ToggleButton Content='Profile' ToolTip.Tip="User Profile"/>
			<ToggleButton Content='Icon' ToolTip.Tip="User Icon" />
			
			

		</WrapPanel>

		<ScrollViewer Grid.Row="7" Grid.ColumnSpan="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
			<TextBox
			  Name="NoteTextBox"
			  AcceptsReturn="True"
			  TextWrapping="Wrap"
			  FontSize="14"
			  Margin="5"
			  ToolTip.Tip="Enter your note here"
			  />
		</ScrollViewer>
		
		<Button Grid.Row="8" Grid.ColumnSpan="4" Content="Copy Note" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

	</Grid>
</Window>
